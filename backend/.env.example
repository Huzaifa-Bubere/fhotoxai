# Video-to-Photo feature configuration (safe template — fill in your own values)
# Copy to a real .env and never commit filled credentials.

# ---- Database (PostgreSQL with pgvector) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<your-password>
DB_NAME=digitalnexusai_emc_db

# ---- FFmpeg binaries (leave unset to use PATH; Docker installs both) ----
# FFMPEG_BIN=C:\path\to\ffmpeg.exe
# FFPROBE_BIN=C:\path\to\ffprobe.exe

# ---- Video feature application limits ----
VIDEO_MAX_UPLOAD_MB=250
VIDEO_MAX_DURATION_SEC=300
VIDEO_MAX_CANDIDATE_FRAMES=300
VIDEO_MAX_FRAME_SIDE_PX=2160
VIDEO_ALLOWED_INTERVALS=0.25,0.5,1,2,5
VIDEO_DEFAULT_INTERVAL_SEC=1
VIDEO_MAX_CONCURRENT_JOBS=1
VIDEO_WORKER_ENABLED=1
VIDEO_FFMPEG_TIMEOUT_SEC=900

# ---- Filter thresholds (heuristics) ----
VIDEO_BLUR_LAPLACIAN_MIN=30
VIDEO_DUP_HAMMING_MAX=6
VIDEO_DUP_WINDOW=40

# ---- AWS S3 (optional; local storage fallback works without it) ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=photo-cluster-frontend

# ---- Frontend URL / CORS ----
FRONTEND_URL=http://localhost:5173
